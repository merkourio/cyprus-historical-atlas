  "components": [
    {
      "name": "Selected language",
      "kind": "button",
      "refersTo": "button-selected",
      "description": "Pressed language or map-view action.",
      "html": "<button class=\"ds-selected\" aria-pressed=\"true\">English</button>",
      "css": ".ds-selected{font-family:var(--font-body,\"Source Sans 3\",Arial,sans-serif);color:var(--ink);background:var(--ink);color:var(--surface);padding:9px 10px;border:0;border-radius:3px;font-size:13px;font-weight:600;cursor:pointer}.ds-selected:hover{color:var(--focus)}.ds-selected:focus-visible{outline:2px solid var(--focus);outline-offset:4px;}@media(prefers-reduced-motion:no-preference){.ds-selected{transition:color .15s,background .15s}}"
    },
    {
      "name": "Era step",
      "kind": "button",
      "refersTo": "button-step",
      "description": "Previous or next era action.",
      "html": "<button class=\"ds-step\" aria-label=\"Next era\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-step{font-family:var(--font-body,\"Source Sans 3\",Arial,sans-serif);color:var(--ink);width:44px;height:44px;background:var(--surface-2);border:0;border-radius:3px;display:grid;place-items:center;cursor:pointer}.ds-step svg{fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round}.ds-step:hover{color:var(--focus)}.ds-step:focus-visible{outline:2px solid var(--focus);outline-offset:4px;}.ds-step:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "Direct-date Go",
      "kind": "button",
      "refersTo": "button-date",
      "description": "Submit the year and BCE/CE choice.",
      "html": "<button class=\"ds-go\">Go</button>",
      "css": ".ds-go{font-family:var(--font-body,\"Source Sans 3\",Arial,sans-serif);color:var(--ink);padding:5px;background:var(--surface-2);border:0;border-radius:3px;font-size:14px;font-weight:600;cursor:pointer}.ds-go:hover{color:var(--focus)}.ds-go:focus-visible{outline:2px solid var(--focus);outline-offset:4px;}"
    },
    {
      "name": "Year field",
      "kind": "input",
      "refersTo": "input-date",
      "description": "Direct numeric date entry.",
      "html": "<label class=\"ds-date-label\" for=\"ds-year\">Go to year</label><input class=\"ds-year\" id=\"ds-year\" type=\"number\" value=\"450\">",
      "css": ".ds-date-label{font-family:var(--font-body,\"Source Sans 3\",Arial,sans-serif);color:var(--ink);display:block;color:var(--muted);font-size:12px}.ds-year{font-family:var(--font-body,\"Source Sans 3\",Arial,sans-serif);color:var(--ink);width:100px;min-width:0;padding:7px;background:var(--surface);border:1px solid var(--line);border-radius:3px;font-size:14px;caret-color:var(--focus)}.ds-year:focus-visible{outline:2px solid var(--focus);outline-offset:4px;}"
    },
    {
      "name": "Information tabs",
      "kind": "nav",
      "refersTo": "navigation-tab",
      "description": "Ruled reading-panel navigation.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Historical information\"><button aria-pressed=\"true\">Overview</button><button aria-pressed=\"false\">Places</button><button aria-pressed=\"false\">Sources</button></nav>",
      "css": ".ds-tabs{display:flex;gap:12px;padding:0 20px;border-bottom:1px solid var(--line);background:var(--surface)}.ds-tabs button{font-family:var(--font-body,\"Source Sans 3\",Arial,sans-serif);color:var(--ink);padding:16px 6px 13px;border:0;border-bottom:3px solid transparent;background:none;font-size:15px;font-weight:600;cursor:pointer}.ds-tabs button[aria-pressed=true]{border-color:var(--focus);color:var(--focus)}.ds-tabs button:hover{color:var(--focus)}.ds-tabs button:focus-visible{outline:2px solid var(--focus);outline-offset:4px;}@media(prefers-reduced-motion:no-preference){.ds-tabs button{transition:color .15s,background .15s}}"
    },
    {
      "name": "Settlement filter",
      "kind": "custom",
      "refersTo": "filter-row",
      "description": "A category row; excluded categories are struck through.",
      "html": "<button class=\"ds-filter\" aria-pressed=\"true\"><i aria-hidden=\"true\"></i><b>Towns</b></button><button class=\"ds-filter\" aria-pressed=\"false\"><i aria-hidden=\"true\"></i><b>Towns</b></button>",
      "css": ".ds-filter{font-family:var(--font-body,\"Source Sans 3\",Arial,sans-serif);color:var(--ink);display:flex;align-items:center;gap:8px;text-align:left;background:none;border:0;padding:7px 0;font-size:14px;cursor:pointer}.ds-filter b{font-weight:400}.ds-filter i{width:9px;height:9px;border-radius:50%;background:var(--k-town)}.ds-filter[aria-pressed=false]{color:var(--muted)}.ds-filter[aria-pressed=false] b{text-decoration:line-through}.ds-filter:hover{color:var(--focus)}.ds-filter:focus-visible{outline:2px solid var(--focus);outline-offset:4px;}"
    },
    {
      "name": "Map evidence container",
      "kind": "card",
      "refersTo": "map-container",
      "description": "A floating legend surface with structural elevation.",
      "html": "<section class=\"ds-map-card\"><strong>Areas of control</strong><div class=\"ds-control-row\"><i aria-hidden=\"true\"></i><span>British Sovereign Base Areas</span></div></section>",
      "css": ".ds-map-card{font-family:var(--font-body,\"Source Sans 3\",Arial,sans-serif);color:var(--ink);background:var(--surface);padding:12px 14px;border-radius:4px;box-shadow:var(--shadow);font-size:13px;max-width:240px}.ds-control-row{display:flex;align-items:center;gap:8px;margin-top:4px}.ds-control-row i{width:10px;height:10px;flex:0 0 10px;background:#5D7387}"
    },
    {
      "name": "Record status",
      "kind": "custom",
      "refersTo": "record-status",
      "description": "Tonal status block within a ruled record.",
      "html": "<p class=\"ds-status\">This place is outside its recorded occupation range.</p>",
      "css": ".ds-status{font-family:var(--font-body,\"Source Sans 3\",Arial,sans-serif);color:var(--ink);background:var(--surface-2);padding:12px 14px;font-size:14px;margin:16px 0}"
    }
  ],
  "narrative": {
    "northStar": "The Archaeological Field Register",
    "overview": "The archaeological field register is the established visual world: cool writing surfaces, mineral sea, stone land and ruled evidence records. Substantive serif headings lend historical weight; compact sans-serif controls keep exploration direct. The interface is dense enough to operate an atlas while preserving a readable narrative measure.\n\nThis is a code-led system extracted from cyprus-historical-explorer.html and the accepted surface direction. There is no approved image composition or shipping raster asset. Maps, symbols and emblems are drawn with canvas/SVG; historical heraldry retains its actual tinctures.",
    "keyCharacteristics": [
      "Cool scholarly material, with explicit light and dark themes.",
      "Compact rectangular controls and ruled record sections.",
      "A linked map, continuous time dock and preserved reading context.",
      "Category symbols, rings and dashed states accompany color."
    ],
    "rules": [
      {
        "name": "Evidence Color",
        "body": "Settlement, era and control colors identify data; reserve the focus token for interaction and selection.",
        "section": "colors"
      },
      {
        "name": "Two Voices",
        "body": "Use the serif for substantive historical headings and geographic annotation; use the sans serif for prose, labels and controls.",
        "section": "typography"
      },
      {
        "name": "Floating Tools",
        "body": "Keep reading surfaces flat and ruled; use elevation to distinguish controls floating over the map and the mobile record sheet.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the cool register palette and its paired dark-theme roles.",
      "Do retain category symbols, capital rings and dashed out-of-date markers alongside color.",
      "Do keep direct year entry available at intermediate widths and on mobile.",
      "Do preserve the selected record and its scroll context while time or filters change.",
      "Do honor visible focus, reduced motion and coarse-pointer sizing."
    ],
    "donts": [
      "Don't introduce artificial ageing, parchment textures or decorative photography.",
      "Don't turn record sections into a stack of rounded promotional cards.",
      "Don't recolor historical heraldry or imply new historical border claims through styling.",
      "Don't claim performance timing, real-device coverage or WCAG certification from the scoped finish verdict."
    ]
  }
}
